rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Global default-deny safety net
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAuthorizedAdmin() {
      return request.auth != null && (
        (
          request.auth.token.email_verified == true &&
          request.auth.token.email in [
            'acp161008@gmail.com',
            'ayushprajapti1610@gmail.com'
          ]
        ) ||
        firestore.exists(
          /databases/ai-studio-456f60b0-146a-4c5a-b616-8a7ca0ff47f0/documents/admins/$(request.auth.uid)
        )
      );
    }

    function isValidProductImage() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    // Permanent product images stored at products/{productId}/{uniqueFileName}
    match /products/{productId}/{fileName} {
      // Customers can publicly view product images from any device without signing in
      allow read: if true;
      // Only authenticated admins can upload or replace validated JPG/PNG/WEBP images (<= 5MB)
      allow create, update: if isAuthorizedAdmin()
        && productId.size() >= 1 && productId.size() <= 128
        && productId.matches('^[a-zA-Z0-9_\\-]+$')
        && fileName.size() >= 1 && fileName.size() <= 160
        && isValidProductImage();
      // Only authenticated admins can delete product images
      allow delete: if isAuthorizedAdmin();
    }

    // Storefront banners stored at banners/{fileName}
    match /banners/{fileName} {
      allow read: if true;
      allow create, update: if isAuthorizedAdmin()
        && fileName.size() >= 1 && fileName.size() <= 160
        && isValidProductImage();
      allow delete: if isAuthorizedAdmin();
    }
  }
}
